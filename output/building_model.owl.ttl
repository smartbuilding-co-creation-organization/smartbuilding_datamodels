    rdfs:label "SubstanceEnum" ;
    owl:unionOf ( <https://www.sbco.or.jp/ont/SubstanceEnum#ACElec> <https://www.sbco.or.jp/ont/SubstanceEnum#Air> <https://www.sbco.or.jp/ont/SubstanceEnum#BlowdownWater> <https://www.sbco.or.jp/ont/SubstanceEnum#ChilledWater> <https://www.sbco.or.jp/ont/SubstanceEnum#ColdDomesticWater> <https://www.sbco.or.jp/ont/SubstanceEnum#Condensate> <https://www.sbco.or.jp/ont/SubstanceEnum#CondenserWater> <https://www.sbco.or.jp/ont/SubstanceEnum#DCElec> <https://www.sbco.or.jp/ont/SubstanceEnum#Diesel> <https://www.sbco.or.jp/ont/SubstanceEnum#DriveElec> <https://www.sbco.or.jp/ont/SubstanceEnum#Ethernet> <https://www.sbco.or.jp/ont/SubstanceEnum#ExhaustAir> <https://www.sbco.or.jp/ont/SubstanceEnum#Freight> <https://www.sbco.or.jp/ont/SubstanceEnum#FuelOil> <https://www.sbco.or.jp/ont/SubstanceEnum#Gasoline> <https://www.sbco.or.jp/ont/SubstanceEnum#GreaseExhaustAir> <https://www.sbco.or.jp/ont/SubstanceEnum#HotDomesticWater> <https://www.sbco.or.jp/ont/SubstanceEnum#HotWater> <https://www.sbco.or.jp/ont/SubstanceEnum#IrrigationWater> <https://www.sbco.or.jp/ont/SubstanceEnum#Light> <https://www.sbco.or.jp/ont/SubstanceEnum#MakeupWater> <https://www.sbco.or.jp/ont/SubstanceEnum#NaturalGas> <https://www.sbco.or.jp/ont/SubstanceEnum#NonPotableDomesticWater> <https://www.sbco.or.jp/ont/SubstanceEnum#OutsideAir> <https://www.sbco.or.jp/ont/SubstanceEnum#People> <https://www.sbco.or.jp/ont/SubstanceEnum#Propane> <https://www.sbco.or.jp/ont/SubstanceEnum#RecircHotDomesticWater> <https://www.sbco.or.jp/ont/SubstanceEnum#Refrig> <https://www.sbco.or.jp/ont/SubstanceEnum#ReturnAir> <https://www.sbco.or.jp/ont/SubstanceEnum#SprinklerWater> <https://www.sbco.or.jp/ont/SubstanceEnum#Steam> <https://www.sbco.or.jp/ont/SubstanceEnum#StormDrainage> <https://www.sbco.or.jp/ont/SubstanceEnum#SupplyAir> <https://www.sbco.or.jp/ont/SubstanceEnum#TransferAir> <https://www.sbco.or.jp/ont/SubstanceEnum#WasteVentDrainage> <https://www.sbco.or.jp/ont/SubstanceEnum#Water> ) ;

        <https://www.sbco.or.jp/ont/SubstanceEnum#CondenserWater>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#DCElec>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#Diesel>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#DriveElec>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#Ethernet>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#ExhaustAir>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#Freight>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#FuelOil>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#Gasoline>,
        <https://www.sbco.or.jp/ont/SubstanceEnum#GreaseExhaustAir>,

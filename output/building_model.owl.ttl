sbco:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range sbco:PostalAddress ;
    skos:definition "Address of the architecture" ;
    skos:inScheme sbco:schema .

sbco:adjacentElement a owl:ObjectProperty ;
    rdfs:label "adjacentElement" ;
    rdfs:range sbco:BuildingElement ;
    skos:definition "Building element adjacent to this architecture" ;
    skos:inScheme sbco:schema .

sbco:architectedBy a owl:ObjectProperty ;
    rdfs:label "architectedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that architected this structure" ;
    skos:inScheme sbco:schema .

sbco:assetTag a owl:DatatypeProperty ;
    rdfs:label "assetTag" ;
    rdfs:range xsd:string ;
    skos:definition "Asset identification tag" ;
    skos:inScheme sbco:schema .

sbco:commissionedBy a owl:ObjectProperty ;
    rdfs:label "commissionedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that commissioned this asset" ;
    skos:inScheme sbco:schema .

sbco:constructedBy a owl:ObjectProperty ;
    rdfs:label "constructedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that constructed this architecture" ;
    skos:inScheme sbco:schema .

sbco:containsElement a owl:ObjectProperty ;
    rdfs:label "containsElement" ;
    rdfs:range sbco:BuildingElement ;
    skos:definition "Building element contained within this architecture" ;
    skos:inScheme sbco:schema .

sbco:entries a owl:ObjectProperty ;
    rdfs:label "entries" ;
    rdfs:range sbco:KeyStringMapEntry ;
    skos:definition "Nested map entries" ;
    skos:inScheme sbco:schema .

sbco:feeds a owl:ObjectProperty ;
    rdfs:label "feeds" ;
    rdfs:range sbco:Resource ;
    skos:definition "Equipment or system that this equipment feeds" ;
    skos:inScheme sbco:schema ;
    sbco:substance "SubstanceEnum" .

sbco:installedBy a owl:ObjectProperty ;
    rdfs:label "installedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that installed this asset" ;
    skos:inScheme sbco:schema .

sbco:intersectingElement a owl:ObjectProperty ;
    rdfs:label "intersectingElement" ;
    rdfs:range sbco:BuildingElement ;
    skos:definition "Building element intersecting with this architecture" ;
    skos:inScheme sbco:schema .

sbco:isLocationOf a owl:ObjectProperty ;
    rdfs:label "isLocationOf" ;
    rdfs:range sbco:EquipmentExt ;
    skos:definition "Subject is the physical location encapsulating the object." ;
    skos:inScheme sbco:schema .

sbco:labels a owl:DatatypeProperty ;
    rdfs:label "labels" ;
    rdfs:range xsd:string ;
    skos:definition "Labels or tags associated with this point" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントに関連するラベルまたはタグ" .

sbco:maintenanceInterval a owl:DatatypeProperty ;
    rdfs:label "maintenanceInterval" ;
    rdfs:range xsd:duration ;
    skos:definition "Maintenance interval duration" ;
    skos:inScheme sbco:schema .

sbco:manufacturedBy a owl:ObjectProperty ;
    rdfs:label "manufacturedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that manufactured this asset" ;
    skos:inScheme sbco:schema .

sbco:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    rdfs:range sbco:Organization ;
    skos:definition "Indicates membership in an organization. Note that componency (e.g., departments of a corporation) are expressed using the more generic Organization.isPartOf property." ;
    skos:inScheme sbco:schema .

sbco:operatedBy a owl:ObjectProperty ;
    rdfs:label "operatedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that operates this architecture" ;
    skos:inScheme sbco:schema .

sbco:ownedBy a owl:ObjectProperty ;
    rdfs:label "ownedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that owns this architecture" ;
    skos:inScheme sbco:schema .

sbco:owns a owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:range sbco:Resource ;
    skos:definition " Indicates ownership of some thing, e.g., a building, an asset, an organization, etc." ;
    skos:inScheme sbco:schema .

sbco:servicedBy a owl:ObjectProperty ;
    rdfs:label "servicedBy" ;
    rdfs:range sbco:Agent ;
    skos:definition "Agent or resource that services this asset" ;
    skos:inScheme sbco:schema .

sbco:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "A document providing information about a building element or asset" ;
    skos:exactMatch rec:Document ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "建物要素やアセットに関する情報を提供するドキュメント" .

sbco:Geometry a owl:Class ;
    rdfs:label "Geometry" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "REC Geometry のプレースホルダ（詳細は別途拡張）" ;
    skos:exactMatch rec:Geometry ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ジオメトリ情報のプレースホルダ" .

sbco:PointExt a owl:Class ;
    rdfs:label "PointExt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:instanceNoBacnet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:installationArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:instanceNoBacnet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty sbco:maxPresValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:maxPresValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:minPresValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:gatewayId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:installationArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty sbco:scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:localId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:deviceIdBacnet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:deviceIdBacnet ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:supplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:gatewayId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty sbco:interval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:pointType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:pointSpecification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:pointType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:deviceIdBacnet ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:gatewayId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:localId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:scale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:objectTypeBacnet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:minPresValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:pointType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:labels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:pointSpecification ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:UnitEnum ;
            owl:onProperty sbco:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:scale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:maxPresValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:pointSpecification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:instanceNoBacnet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty sbco:minPresValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:localId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty sbco:writable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:objectTypeBacnet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:labels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:PointSpecificationEnum ;
            owl:onProperty sbco:pointSpecification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:installationArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( sbco:Equipment sbco:EquipmentExt ) ] ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:pointType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:objectTypeBacnet ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:writable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:writable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:interval ],
        sbco:Point ;
    skos:definition "A point (sensor/actuator) in a smart building context." ;
    skos:exactMatch sbco:PointExt ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "スマートビルディングの文脈におけるポイント（センサー/アクチュエータ）。" .

sbco:aggregate a owl:ObjectProperty ;
    rdfs:label "aggregate" ;
    rdfs:range sbco:AggregateEnum ;
    skos:definition "Aggregation function or method for point data processing" ;
    skos:inScheme sbco:schema ;
    sbco:azure_dtdl_type "DTObjectInfo" ;
    sbco:description_ja "ポイントデータ処理のための集約関数または方法" .

sbco:area a owl:ObjectProperty ;
    rdfs:label "area" ;
    rdfs:range sbco:ArchitectureArea ;
    skos:definition "Area of the architecture" ;
    skos:inScheme sbco:schema .

sbco:capacity a owl:ObjectProperty ;
    rdfs:label "capacity" ;
    rdfs:range sbco:ArchitectureCapacity ;
    skos:definition "Capacity of the architecture" ;
    skos:inScheme sbco:schema .

sbco:checksum a owl:DatatypeProperty ;
    rdfs:label "checksum" ;
    rdfs:range xsd:string ;
    skos:definition "Checksum or hash of the information content" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報コンテンツのチェックサムまたはハッシュ" .

sbco:commissioningDate a owl:DatatypeProperty ;
    rdfs:label "commissioningDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the asset was commissioned" ;
    skos:inScheme sbco:schema .

sbco:deviceIdBacnet a owl:DatatypeProperty ;
    rdfs:label "deviceIdBacnet" ;
    rdfs:range xsd:string ;
    skos:definition "BACnet device identifier" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "BACnetデバイス識別子" .

sbco:deviceType a owl:DatatypeProperty ;
    rdfs:label "deviceType" ;
    rdfs:range xsd:string ;
    skos:definition "Device Type" ;
    skos:inScheme sbco:schema .

sbco:flag a owl:DatatypeProperty ;
    rdfs:label "flag" ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag value" ;
    skos:inScheme sbco:schema .

sbco:format a owl:DatatypeProperty ;
    rdfs:label "format" ;
    rdfs:range xsd:string ;
    skos:definition "MIME type or format identifier for the information" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報のMIMEタイプまたはフォーマット識別子" .

sbco:gatewayId a owl:DatatypeProperty ;
    rdfs:label "gatewayId" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of the gateway device managing this point" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントを管理するゲートウェイデバイスの識別子" .

sbco:georeference a owl:ObjectProperty ;
    rdfs:label "georeference" ;
    rdfs:range sbco:Georeference ;
    skos:definition "A georeference creates a relationship between the local coordinate system used within a building (e.g., measured in meters) and a geographic coordinate system (e.g., lat, long, alt), such that locally placed Spaces can be resolved and rendered in that geographic coordinate system (e.g., for mapping purposes)." ;
    skos:inScheme sbco:schema .

sbco:hasQuantity a owl:ObjectProperty ;
    rdfs:label "hasQuantity" ;
    rdfs:range sbco:QuantityEnum ;
    skos:definition "Physical quantity measured by this point" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントで測定される物理量" .

sbco:hasSubstance a owl:ObjectProperty ;
    rdfs:label "hasSubstance" ;
    rdfs:range sbco:SubstanceEnum ;
    skos:definition "Substance associated with this point" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントに関連する物質" .

sbco:initialCost a owl:DatatypeProperty ;
    rdfs:label "initialCost" ;
    rdfs:range xsd:string ;
    skos:definition "Initial cost of the asset" ;
    skos:inScheme sbco:schema .

sbco:installationDate a owl:DatatypeProperty ;
    rdfs:label "installationDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the asset was installed" ;
    skos:inScheme sbco:schema .

sbco:instanceNoBacnet a owl:DatatypeProperty ;
    rdfs:label "instanceNoBacnet" ;
    rdfs:range xsd:string ;
    skos:definition "BACnet object instance number" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "BACnetオブジェクトインスタンス番号" .

sbco:interval a owl:DatatypeProperty ;
    rdfs:label "interval" ;
    rdfs:range xsd:integer ;
    skos:definition "Polling or reporting interval in seconds" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ポーリングまたはレポートの間隔（秒）" .

sbco:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}(-[A-Z]{2})?$" ] ) ] ) ] ;
    skos:definition "Language code (ISO 639-1) of the information content" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報コンテンツの言語コード (ISO 639-1)" .

sbco:levelNumber a owl:DatatypeProperty ;
    rdfs:label "levelNumber" ;
    rdfs:range xsd:integer ;
    skos:definition "Floor or level number within a building" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "建物内のフロアまたはレベル番号" .

sbco:localId a owl:DatatypeProperty ;
    rdfs:label "localId" ;
    rdfs:range xsd:string ;
    skos:definition "Local identifier for this point within the gateway or system" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ゲートウェイまたはシステム内でのポイントのローカル識別子" .

sbco:maxPresValue a owl:DatatypeProperty ;
    rdfs:label "maxPresValue" ;
    rdfs:range xsd:float ;
    skos:definition "Maximum plausible reading" ;
    skos:inScheme sbco:schema .

sbco:minPresValue a owl:DatatypeProperty ;
    rdfs:label "minPresValue" ;
    rdfs:range xsd:float ;
    skos:definition "Minimum plausible reading" ;
    skos:inScheme sbco:schema .

sbco:modelNumber a owl:DatatypeProperty ;
    rdfs:label "modelNumber" ;
    rdfs:range xsd:string ;
    skos:definition "Model number of the asset" ;
    skos:inScheme sbco:schema .

sbco:mountedOn a owl:ObjectProperty ;
    rdfs:label "mountedOn" ;
    rdfs:range sbco:BuildingElement ;
    skos:definition "Building element on which this asset is mounted" ;
    skos:inScheme sbco:schema .

sbco:objectTypeBacnet a owl:DatatypeProperty ;
    rdfs:label "objectTypeBacnet" ;
    rdfs:range xsd:string ;
    skos:definition "BACnet object type (e.g., Analog-Input, Binary-Output)" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "BACnetオブジェクトタイプ（例：Analog-Input、Binary-Output）" .

sbco:operationalStageCount a owl:DatatypeProperty ;
    rdfs:label "operationalStageCount" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of operational stages supported by this equipment" ;
    skos:inScheme sbco:schema .

sbco:panel a owl:DatatypeProperty ;
    rdfs:label "panel" ;
    rdfs:range xsd:string ;
    skos:definition "Parent panel" ;
    skos:inScheme sbco:schema .

sbco:pointSpecification a owl:ObjectProperty ;
    rdfs:label "pointSpecification" ;
    rdfs:range sbco:PointSpecificationEnum ;
    skos:definition "Point specification category as shown in equipment point list. English is recommended." ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "設備のポイントリストで示される、ポイントの区分を明示。" .

sbco:pointType a owl:DatatypeProperty ;
    rdfs:label "pointType" ;
    rdfs:range xsd:string ;
    skos:definition "Point type - a profile or template name used to refer to the telemetry format obtainable from the device or point. Specific definitions are provided separately in schema files." ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ポイントタイプ - 機器やポイントから取得できるテレメトリのフォーマットを参照するためのプロファイル名、またはテンプレート名。具体的な定義については、スキーマファイル等で当該タイプについては別途定義される。" .

sbco:scale a owl:DatatypeProperty ;
    rdfs:label "scale" ;
    rdfs:range xsd:float ;
    skos:definition "Scale factor for raw value conversion" ;
    skos:inScheme sbco:schema .

sbco:serialNumber a owl:DatatypeProperty ;
    rdfs:label "serialNumber" ;
    rdfs:range xsd:string ;
    skos:definition "Serial number of the asset" ;
    skos:inScheme sbco:schema .

sbco:size a owl:DatatypeProperty ;
    rdfs:label "size" ;
    rdfs:range xsd:integer ;
    skos:definition "Size of the information resource in bytes" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報リソースのサイズ（バイト）" .

sbco:supplier a owl:DatatypeProperty ;
    rdfs:label "supplier" ;
    rdfs:range xsd:string ;
    skos:definition "Supplier or vendor of the device associated with this point" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントに関連するデバイスのサプライヤーまたはベンダー" .

sbco:turnoverDate a owl:DatatypeProperty ;
    rdfs:label "turnoverDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the asset was turned over" ;
    skos:inScheme sbco:schema .

sbco:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range sbco:UnitEnum ;
    skos:definition "Measurement unit (enum key; symbol can be taken from annotations)" ;
    skos:inScheme sbco:schema .

sbco:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL or URI pointing to the information resource" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報リソースを指すURLまたはURI" .

sbco:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "Value of the map entry" ;
    skos:inScheme sbco:schema .

sbco:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier for the information" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "情報のバージョン識別子" .

sbco:weight a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    rdfs:range xsd:decimal ;
    skos:definition "Weight of the asset" ;
    skos:inScheme sbco:schema .

sbco:writable a owl:DatatypeProperty ;
    rdfs:label "writable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the point value can be written (commanded)" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ポイントの値を書き込み（制御）できるかどうか" .

sbco:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sbco:Resource ;
            owl:onProperty sbco:feeds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty sbco:operationalStageCount ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:locatedIn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:feeds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isFedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:operationalStageCount ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Resource ;
            owl:onProperty sbco:isFedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:operationalStageCount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:locatedIn ],
        sbco:Asset ;
    skos:definition "An equipment asset installed in a space." ;
    skos:exactMatch brick:Equipment ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "空間に設置された設備アセット。" .

sbco:EquipmentExt a owl:Class ;
    rdfs:label "EquipmentExt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:panel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:deviceType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:installationArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:panel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:installationArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:locatedIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:deviceType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:deviceType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:targetArea ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:panel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:locatedIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:installationArea ],
        sbco:Equipment ;
    skos:definition "An equipment asset installed in a space." ;
    skos:exactMatch sbco:EquipmentExt ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "SBCOにて拡張したデバイスモデル" .

sbco:documentation a owl:ObjectProperty ;
    rdfs:label "documentation" ;
    rdfs:range sbco:Document ;
    skos:definition "Documentation related to this asset" ;
    skos:inScheme sbco:schema .

sbco:hasPart a owl:ObjectProperty ;
    rdfs:label "hasPart" ;
    rdfs:range sbco:Space ;
    skos:definition "The subject is composed in part of the entity given by the object." ;
    skos:inScheme sbco:schema .

sbco:hasPoint a owl:ObjectProperty ;
    rdfs:label "hasPoint" ;
    rdfs:range sbco:Point ;
    skos:definition "Point associated with this architecture" ;
    skos:inScheme sbco:schema .

sbco:isFedBy a owl:ObjectProperty ;
    rdfs:label "isFedBy" ;
    rdfs:range sbco:Resource ;
    skos:definition "Resource that feeds this architecture" ;
    skos:inScheme sbco:schema ;
    sbco:substance "SubstanceEnum" .

sbco:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    owl:unionOf ( <https://www.sbco.or.jp/ont/UnitEnum#celsius> <https://www.sbco.or.jp/ont/UnitEnum#percent> <https://www.sbco.or.jp/ont/UnitEnum#ppm> ) ;
    skos:definition "Allowed measurement units" ;
    skos:inScheme sbco:schema ;
    linkml:permissible_values <https://www.sbco.or.jp/ont/UnitEnum#celsius>,
        <https://www.sbco.or.jp/ont/UnitEnum#percent>,
        <https://www.sbco.or.jp/ont/UnitEnum#ppm> .

sbco:Architecture a owl:Class ;
    rdfs:label "Architecture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:intersectingElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:address ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:ownedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( sbco:Point sbco:PointExt ) ] sbco:Point ) ] ;
            owl:onProperty sbco:hasPoint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:constructedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isFedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:operatedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:containsElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:BuildingElement ;
            owl:onProperty sbco:intersectingElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:ArchitectureCapacity ;
            owl:onProperty sbco:capacity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:documentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Document ;
            owl:onProperty sbco:documentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:constructedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:ownedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:adjacentElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:ArchitectureArea ;
            owl:onProperty sbco:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Resource ;
            owl:onProperty sbco:isFedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:capacity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:architectedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:capacity ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:BuildingElement ;
            owl:onProperty sbco:adjacentElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:PostalAddress ;
            owl:onProperty sbco:address ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:ArchitectureArea ;
            owl:onProperty sbco:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:capacity ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:ArchitectureCapacity ;
            owl:onProperty sbco:capacity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:architectedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:operatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:BuildingElement ;
            owl:onProperty sbco:containsElement ],
        sbco:Space ;
    skos:definition "A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc." ;
    skos:exactMatch rec:Architecture ;
    skos:inScheme sbco:schema .

sbco:Point a owl:Class ;
    rdfs:label "Point" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:hasQuantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasSubstance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:AggregateEnum ;
            owl:onProperty sbco:aggregate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:aggregate ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Equipment ;
            owl:onProperty sbco:isPointOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:QuantityEnum ;
            owl:onProperty sbco:hasQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:hasSubstance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:aggregate ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:SubstanceEnum ;
            owl:onProperty sbco:hasSubstance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ] ;
    skos:definition "A sensor, actuator, or data point associated with equipment." ;
    skos:exactMatch brick:Point ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "設備に紐づくセンサー/アクチュエータ/データポイント。" .

sbco:geometry a owl:ObjectProperty ;
    rdfs:label "geometry" ;
    rdfs:range sbco:Geometry ;
    skos:definition "Polygon representing the spatial extent of this Space." ;
    skos:inScheme sbco:schema .

sbco:installationArea a owl:DatatypeProperty ;
    rdfs:label "installationArea" ;
    rdfs:range xsd:string ;
    skos:definition "Parent installation area" ;
    skos:inScheme sbco:schema .

sbco:isPartOf a owl:ObjectProperty ;
    rdfs:label "isPartOf" ;
    rdfs:range sbco:Space ;
    skos:inScheme sbco:schema .

sbco:isPointOf a owl:ObjectProperty ;
    rdfs:label "isPointOf" ;
    rdfs:range sbco:Equipment ;
    skos:definition "Equipment that this point belongs to" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "このポイントが属する設備" .

sbco:locatedIn a owl:ObjectProperty ;
    rdfs:label "locatedIn" ;
    rdfs:range sbco:Space ;
    skos:definition "Space where this asset is located" ;
    skos:inScheme sbco:schema .

sbco:targetArea a owl:DatatypeProperty ;
    rdfs:label "targetArea" ;
    rdfs:range xsd:string ;
    skos:definition "Target area for this resource" ;
    skos:inScheme sbco:schema .

sbco:Information a owl:Class ;
    rdfs:label "Information" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:checksum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:checksum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty sbco:size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:checksum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:size ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:checksum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty sbco:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}(-[A-Z]{2})?$" ] ) ] ) ] ;
            owl:onProperty sbco:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty sbco:url ],
        sbco:Resource ;
    skos:definition "Abstract base class for information resources such as documents, images, media files, etc." ;
    skos:exactMatch rec:Information ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ドキュメント、画像、メディアファイルなどの情報リソースの抽象基底クラス" .

sbco:BuildingElement a owl:Class ;
    rdfs:label "BuildingElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        sbco:Resource ;
    skos:definition "A part of the building structure" ;
    skos:exactMatch rec:BuildingElement ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "建物構造の一部" .

sbco:PointSpecificationEnum a owl:Class ;
    rdfs:label "PointSpecificationEnum" ;
    owl:unionOf ( <https://www.sbco.or.jp/ont/PointSpecificationEnum#Alarm> <https://www.sbco.or.jp/ont/PointSpecificationEnum#Command> <https://www.sbco.or.jp/ont/PointSpecificationEnum#Setpoint> <https://www.sbco.or.jp/ont/PointSpecificationEnum#Measurement> <https://www.sbco.or.jp/ont/PointSpecificationEnum#Metering> <https://www.sbco.or.jp/ont/PointSpecificationEnum#Status> ) ;
    skos:definition "Point specification categories for equipment point lists" ;
    skos:inScheme sbco:schema ;
    linkml:permissible_values <https://www.sbco.or.jp/ont/PointSpecificationEnum#Alarm>,
        <https://www.sbco.or.jp/ont/PointSpecificationEnum#Command>,
        <https://www.sbco.or.jp/ont/PointSpecificationEnum#Measurement>,
        <https://www.sbco.or.jp/ont/PointSpecificationEnum#Metering>,
        <https://www.sbco.or.jp/ont/PointSpecificationEnum#Setpoint>,
        <https://www.sbco.or.jp/ont/PointSpecificationEnum#Status> ;
    sbco:description_ja "設備のポイントリストで示される、ポイントの区分" .

sbco:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A textual description of the resource" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "リソースのテキスト記述" .

sbco:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    rdfs:range xsd:string ;
    skos:definition "Key of the map entry" ;
    skos:inScheme sbco:schema .

sbco:AggregateEnum a owl:Class ;
    rdfs:label "AggregateEnum" ;
    owl:unionOf ( <https://www.sbco.or.jp/ont/AggregateEnum#average> <https://www.sbco.or.jp/ont/AggregateEnum#sum> <https://www.sbco.or.jp/ont/AggregateEnum#minimum> <https://www.sbco.or.jp/ont/AggregateEnum#maximum> <https://www.sbco.or.jp/ont/AggregateEnum#count> <https://www.sbco.or.jp/ont/AggregateEnum#first> <https://www.sbco.or.jp/ont/AggregateEnum#last> <https://www.sbco.or.jp/ont/AggregateEnum#median> <https://www.sbco.or.jp/ont/AggregateEnum#standardDeviation> ) ;
    skos:definition "Aggregation functions for point data processing" ;
    skos:inScheme sbco:schema ;
    linkml:permissible_values <https://www.sbco.or.jp/ont/AggregateEnum#average>,
        <https://www.sbco.or.jp/ont/AggregateEnum#count>,
        <https://www.sbco.or.jp/ont/AggregateEnum#first>,
        <https://www.sbco.or.jp/ont/AggregateEnum#last>,
        <https://www.sbco.or.jp/ont/AggregateEnum#maximum>,
        <https://www.sbco.or.jp/ont/AggregateEnum#median>,
        <https://www.sbco.or.jp/ont/AggregateEnum#minimum>,
        <https://www.sbco.or.jp/ont/AggregateEnum#standardDeviation>,
        <https://www.sbco.or.jp/ont/AggregateEnum#sum> ;
    sbco:description_ja "ポイントデータ処理のための集約関数" .

sbco:KeyBoolMapEntry a owl:Class ;
    rdfs:label "KeyBoolMapEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:flag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty sbco:flag ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:flag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:key ] ;
    skos:definition "map(string -> boolean) の1エントリ" ;
    skos:inScheme sbco:schema .

sbco:KeyMapOfStringMapEntry a owl:Class ;
    rdfs:label "KeyMapOfStringMapEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:entries ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:entries ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:key ] ;
    skos:definition "map(string -> map(string -> string)) の1エントリ" ;
    skos:inScheme sbco:schema .

sbco:Space a owl:Class ;
    rdfs:label "Space" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:georeference ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:georeference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:EquipmentExt ;
            owl:onProperty sbco:isLocationOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Geometry ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Georeference ;
            owl:onProperty sbco:georeference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isLocationOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:description ] ;
    skos:definition "A contiguous part of the physical world that contains or can contain sub-spaces. E.g., a Region can contain many Sites, which in turn can contain many Buildings." ;
    skos:exactMatch rec:Space ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "室やゾーンなどの空間単位。設備を含みうる。" .

sbco:KeyStringMapEntry a owl:Class ;
    rdfs:label "KeyStringMapEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:key ] ;
    skos:definition "map(string -> string) の1エントリ" ;
    skos:inScheme sbco:schema .

sbco:Resource a owl:Class ;
    rdfs:label "Resource" ;
    skos:definition "Base class for all resources" ;
    skos:exactMatch rdfs:Resource ;
    skos:inScheme sbco:schema .

sbco:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:owns ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Resource ;
            owl:onProperty sbco:owns ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Organization ;
            owl:onProperty sbco:memberOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:memberOf ],
        sbco:Resource ;
    skos:definition "An entity that can act or be acted upon" ;
    skos:exactMatch rec:Agent ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "行動することができる、または行動される主体" .

sbco:customProperties a owl:ObjectProperty ;
    rdfs:label "customProperties" ;
    rdfs:range sbco:KeyMapOfStringMapEntry ;
    skos:definition "map(string -> map(string -> string))" ;
    skos:inScheme sbco:schema .

sbco:customTags a owl:ObjectProperty ;
    rdfs:label "customTags" ;
    rdfs:range sbco:KeyBoolMapEntry ;
    skos:definition "map(string -> boolean)" ;
    skos:inScheme sbco:schema .

sbco:identifiers a owl:ObjectProperty ;
    rdfs:label "identifiers" ;
    rdfs:range sbco:KeyStringMapEntry ;
    skos:definition "map(string -> string)" ;
    skos:inScheme sbco:schema .

sbco:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier within the schema. Must start with a letter and contain only letters, digits, underscores, hyphens, colons, semicolons, or periods. DTMI is one acceptable example." ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "スキーマ内の一意識別子。文字で開始し、DTMI形式もサポート。" ;
    sbco:example "dtmi:example:Building:1" .

sbco:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Machine or Human-readable name" ;
    skos:inScheme sbco:schema .


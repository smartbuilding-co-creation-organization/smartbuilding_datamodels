@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://w3id.org/rec/> .
@prefix sbco: <https://www.sbco.or.jp/ont/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

linkml:Any a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

sbco:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf sbco:Architecture ;
    skos:definition "A building which is part of a site." ;
    skos:exactMatch rec:Building ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "サイトの一部である建物。" .

sbco:Image a owl:Class ;
    rdfs:label "Image" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "An image file containing visual information" ;
    skos:exactMatch rec:Image ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "視覚情報を含む画像ファイル" .

sbco:Level a owl:Class ;
    rdfs:label "Level" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty sbco:levelNumber ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:levelNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:levelNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:levelNumber ],
        sbco:Architecture ;
    skos:definition "A building storey. Levels can also be treated as a kind of space." ;
    skos:exactMatch rec:Level ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "建物のフロア。スペースの一種として扱える。" .

sbco:Media a owl:Class ;
    rdfs:label "Media" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "A media file such as audio or video content" ;
    skos:exactMatch rec:Media ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "オーディオやビデオコンテンツなどのメディアファイル" .

sbco:OutdoorSpace a owl:Class ;
    rdfs:label "OutdoorSpace" ;
    rdfs:subClassOf sbco:Architecture ;
    skos:definition "An outdoor space associated with a site or building." ;
    skos:exactMatch rec:OutdoorSpace ;
    skos:inScheme sbco:schema .

sbco:Room a owl:Class ;
    rdfs:label "Room" ;
    rdfs:subClassOf sbco:Architecture ;
    skos:definition "A room within a building." ;
    skos:exactMatch rec:Room ;
    skos:inScheme sbco:schema .

sbco:Schema a owl:Class ;
    rdfs:label "Schema" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "A schema definition file" ;
    skos:exactMatch rec:Schema ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "スキーマ定義ファイル" .

sbco:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:subClassOf sbco:Architecture ;
    skos:definition "A piece of land upon which zero or more buildings may be situated." ;
    skos:exactMatch rec:Site ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "サイト。複数の建物を含みうる。" .

sbco:Zone a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:subClassOf sbco:Architecture ;
    skos:definition "A sub-zone within or outside of a building defined to support some technology and/or use." ;
    skos:exactMatch rec:Zone ;
    skos:inScheme sbco:schema .

sbco:altitude a owl:DatatypeProperty ;
    rdfs:label "altitude" ;
    rdfs:range xsd:float ;
    skos:definition "Altitude above sea level in meters" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "海抜高度（メートル）" .

sbco:coordinates a owl:DatatypeProperty ;
    rdfs:label "coordinates" ;
    rdfs:range xsd:string ;
    skos:definition "Geographic coordinates defining the geofence boundary" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "ジオフェンス境界を定義する地理座標" .

sbco:intervalCapability a owl:DatatypeProperty ;
    rdfs:label "intervalCapability" ;
    rdfs:range xsd:integer ;
    skos:definition "Polling period (period speed that the device is capable of)" ;
    skos:inScheme sbco:schema .

sbco:radius a owl:DatatypeProperty ;
    rdfs:label "radius" ;
    rdfs:range xsd:float ;
    skos:definition "Radius in meters for circular geofences" ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "円形ジオフェンスの半径（メートル）" .

sbco:schema.owl.ttl a owl:Ontology ;
    rdfs:label "building_model" ;
    dcterms:title "Smart Building Model" ;
    skos:definition """A LinkML schema for sites, buildings, spaces, equipment, and points used in smart-building data exchanges.
""" .

sbco:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasPoint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:modelNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:assetTag ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$" ] ) ] ) ] ;
            owl:onProperty sbco:IPAddress ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:locatedIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:installationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:modelNumber ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:MACAddress ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:serialNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:weight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:commissioningDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:serialNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:commissionedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Space ;
            owl:onProperty sbco:locatedIn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:commissioningDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:turnoverDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:serialNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:installedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Document ;
            owl:onProperty sbco:documentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty sbco:installationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:maintenanceInterval ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:installationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:mountedOn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:initialCost ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:modelNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:commissioningDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:installedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:manufacturedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" ] ) ] ) ] ;
            owl:onProperty sbco:MACAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:manufacturedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:installedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:assetTag ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Agent ;
            owl:onProperty sbco:servicedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:manufacturedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:mountedOn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty sbco:maintenanceInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty sbco:commissioningDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:servicedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:weight ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:IPAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty sbco:turnoverDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:Geometry ;
            owl:onProperty sbco:geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:initialCost ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:turnoverDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:initialCost ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:BuildingElement ;
            owl:onProperty sbco:mountedOn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:commissionedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( sbco:Point sbco:PointExt ) ] sbco:Point ) ] ;
            owl:onProperty sbco:hasPoint ],
        sbco:Resource ;
    skos:definition "Something which is placed inside of a building, but is not an integral part of that building's structure; e.g., furniture, equipment, systems, etc." ;
    skos:exactMatch rec:Asset ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "建物内に配置されるが、建物構造の不可欠な部分ではないもの。例：家具、設備、システムなど。" .

xsd:duration a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^P(?:\\d+Y)?(?:\\d+M)?(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$" ] ) ] ) ] .

<https://www.sbco.or.jp/ont/AggregateEnum#average> a owl:Class ;
    rdfs:label "average" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Average value" .

<https://www.sbco.or.jp/ont/AggregateEnum#count> a owl:Class ;
    rdfs:label "count" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Count of values" .

<https://www.sbco.or.jp/ont/AggregateEnum#first> a owl:Class ;
    rdfs:label "first" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "First value" .

<https://www.sbco.or.jp/ont/AggregateEnum#last> a owl:Class ;
    rdfs:label "last" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Last value" .

<https://www.sbco.or.jp/ont/AggregateEnum#maximum> a owl:Class ;
    rdfs:label "maximum" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Maximum value" .

<https://www.sbco.or.jp/ont/AggregateEnum#median> a owl:Class ;
    rdfs:label "median" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Median value" .

<https://www.sbco.or.jp/ont/AggregateEnum#minimum> a owl:Class ;
    rdfs:label "minimum" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Minimum value" .

<https://www.sbco.or.jp/ont/AggregateEnum#standardDeviation> a owl:Class ;
    rdfs:label "standardDeviation" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Standard deviation" .

<https://www.sbco.or.jp/ont/AggregateEnum#sum> a owl:Class ;
    rdfs:label "sum" ;
    rdfs:subClassOf sbco:AggregateEnum ;
    skos:definition "Sum of values" .

sbco:ArchitectureArea a owl:Class ;
    rdfs:label "ArchitectureArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        sbco:Resource ;
    skos:definition "Describes business-relevant area measurements typically associated with architected spaces" ;
    skos:exactMatch rec:ArchitectureArea ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "設計された空間に関連する業務上重要な面積測定" .

sbco:ArchitectureCapacity a owl:Class ;
    rdfs:label "ArchitectureCapacity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyStringMapEntry ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        sbco:Resource ;
    skos:definition "Describes business-relevant capacity measurements typically associated with architected spaces" ;
    skos:exactMatch rec:ArchitectureCapacity ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "設計された空間に関連する業務上重要な容量測定" .

sbco:Georeference a owl:Class ;
    rdfs:label "Georeference" ;
    rdfs:subClassOf sbco:Information ;
    skos:definition "REC Georeference のプレースホルダ（詳細は別途拡張）" ;
    skos:exactMatch rec:Georeference ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "地理参照情報のプレースホルダ" .

sbco:IPAddress a owl:DatatypeProperty ;
    rdfs:label "IPAddress" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$" ] ) ] ) ] ;
    skos:definition "IP address of the asset" ;
    skos:inScheme sbco:schema .

sbco:MACAddress a owl:DatatypeProperty ;
    rdfs:label "MACAddress" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" ] ) ] ) ] ;
    skos:definition "MAC address of the asset" ;
    skos:inScheme sbco:schema .

sbco:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyBoolMapEntry ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customProperties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty sbco:customTags ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sbco:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom sbco:KeyMapOfStringMapEntry ;
            owl:onProperty sbco:customProperties ],
        sbco:Agent ;
    skos:definition "An organization such as a company, institution, or association" ;
    skos:exactMatch rec:Organization ;
    skos:inScheme sbco:schema ;
    sbco:description_ja "会社、機関、協会などの組織" .

<https://www.sbco.or.jp/ont/PointSpecificationEnum#Alarm> a owl:Class ;
    rdfs:label "Alarm" ;
    rdfs:subClassOf sbco:PointSpecificationEnum ;
    skos:definition "Alarm point" ;
    sbco:description_ja "警報" .

<https://www.sbco.or.jp/ont/PointSpecificationEnum#Command> a owl:Class ;
    rdfs:label "Command" ;
    rdfs:subClassOf sbco:PointSpecificationEnum ;
    skos:definition "Control command point" ;
    sbco:description_ja "制御" .

<https://www.sbco.or.jp/ont/PointSpecificationEnum#Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf sbco:PointSpecificationEnum ;
    skos:definition "Measurement point" ;
    sbco:description_ja "計測" .

<https://www.sbco.or.jp/ont/PointSpecificationEnum#Metering> a owl:Class ;
    rdfs:label "Metering" ;
    rdfs:subClassOf sbco:PointSpecificationEnum ;
    skos:definition "Metering point" ;
    sbco:description_ja "計量" .

<https://www.sbco.or.jp/ont/PointSpecificationEnum#Setpoint> a owl:Class ;
    rdfs:label "Setpoint" ;
    rdfs:subClassOf sbco:PointSpecificationEnum ;
    skos:definition "Setpoint configuration point" ;
    sbco:description_ja "設定" .

